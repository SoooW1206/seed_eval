          << "      --num-haplotypes N        haplotypes candidates to sample (default: " << IndexingParameters::haplotype_sampling_num_haplotypes << ")" << endl
          << "      --no-diploid-sampling     turn off downsampling candidates to best diploid" << endl;
 
